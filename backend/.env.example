# Copy to .env and fill real values. Never commit .env
APP_NAME=따릉따라 API
ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_LAT=37.5665
DEFAULT_LNG=126.9780

# Secrets — leave empty in example; set only in local .env
DATABASE_URL=
JWT_SECRET=

# 카카오 REST API 키 — 로컬 장소 검색 (키워드)
# 발급: https://developers.kakao.com/ → 내 애플리케이션 → 앱 키 → REST API 키
# 사용: GET /api/places/search?q=...
# 미설정 시 mock 장소 폴백
KAKAO_REST_KEY=

# 서울 열린데이터 인증키 — 따릉이 실시간 bikeList
# https://data.seoul.go.kr/dataList/OA-15493/A/1/datasetView.do
# 예: http://openapi.seoul.go.kr:8088/{KEY}/json/bikeList/1/1000/
SEOUL_OPENAPI_KEY=
# 생활안전지도 오픈API 인증키 (자전거길 WMS IF_0101)
# 발급: https://www.safemap.go.kr/opna/crtfc/keyAgreeRenew.do
# 데이터: https://www.safemap.go.kr/opna/data/dataViewRenew.do?objtId=219
SAFEMAP_SERVICE_KEY=
# 기상청 API 허브 인증키 — 공식 기상특보(폭염·호우 등)
# https://apihub.kma.go.kr/ 회원가입 → 연락처 인증 → 예특보/기상특보 활용신청
# 사용 API: /api/typ01/url/wrn_now_data.php (특보현황)
# 미설정 시 Open-Meteo 조건 기반 주의 안내만 표시
KMA_APIHUB_KEY=
# (선택) 구 키 별칭 — KMA_APIHUB_KEY 없을 때 폴백
WEATHER_API_KEY=
AIR_API_KEY=
REDIS_URL=
