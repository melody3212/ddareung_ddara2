# Copy to .env and fill real values. Never commit .env
APP_NAME=따릉따라 API
ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_LAT=37.5665
DEFAULT_LNG=126.9780

# Secrets — leave empty in example; set only in local .env
DATABASE_URL=
JWT_SECRET=
KAKAO_REST_KEY=
# 서울 열린데이터 인증키 — 따릉이 실시간 bikeList
# https://data.seoul.go.kr/dataList/OA-15493/A/1/datasetView.do
# 예: http://openapi.seoul.go.kr:8088/{KEY}/json/bikeList/1/1000/
SEOUL_OPENAPI_KEY=
# 생활안전지도 오픈API 인증키 (자전거길 WMS IF_0101)
# 발급: https://www.safemap.go.kr/opna/crtfc/keyAgreeRenew.do
# 데이터: https://www.safemap.go.kr/opna/data/dataViewRenew.do?objtId=219
SAFEMAP_SERVICE_KEY=
WEATHER_API_KEY=
AIR_API_KEY=
REDIS_URL=
