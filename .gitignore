# Dependencies
node_modules/
frontend/node_modules/
backend/.venv/
backend/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# ── Env & secrets (never commit) ───────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Explicit app envs
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Common secret / credential filenames
*.pem
*.key
*.p12
*.pfx
*secret*
*credentials*
!*credentials*.example
secrets/
.secrets/
config/local.*
**/local.settings.json
**/serviceAccount*.json
**/firebase*.json
!**/firebase*.example.json

# API key dumps / local overrides
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build / dist
frontend/dist/
frontend/dev-dist/
backend/dist/
*.egg-info/
.coverage
htmlcov/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# Logs & local
*.log
.npm
.cache/
tmp/
temp/

# Local DB / data dumps
*.db
*.sqlite3
backend/data/local/

# Office lock / temp
~$*
*.tmp
